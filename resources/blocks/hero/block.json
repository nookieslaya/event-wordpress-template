{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "event/hero",
  "title": "Event Hero",
  "category": "design",
  "icon": "cover-image",
  "description": "Hero section with staggered reveal and CTA buttons.",
  "textdomain": "sage",
  "supports": {
    "align": ["full"],
    "anchor": true,
    "html": false
  },
  "attributes": {
    "lineOne": { "type": "string", "default": "WHERE" },
    "lineTwo": { "type": "string", "default": "LIGHT MEETS" },
    "lineThree": { "type": "string", "default": "SPECTACLE" },
    "description": {
      "type": "string",
      "default": "Creating unforgettable live experiences through innovative production, cutting-edge technology, and artistic excellence."
    },
    "primaryLabel": { "type": "string", "default": "Start Your Project" },
    "primaryUrl": { "type": "string", "default": "#contact" },
    "secondaryLabel": { "type": "string", "default": "View Our Work" },
    "secondaryUrl": { "type": "string", "default": "#services" },
    "backgroundImageId": { "type": "number", "default": 0 },
    "backgroundImageUrl": { "type": "string", "default": "" }
  }
}
