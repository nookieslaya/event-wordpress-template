{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "event/services-grid",
  "title": "Event Services Grid",
  "category": "design",
  "icon": "grid-view",
  "description": "Services section with editable cards.",
  "textdomain": "sage",
  "supports": {
    "anchor": true,
    "html": false
  },
  "attributes": {
    "titlePrefix": { "type": "string", "default": "OUR" },
    "titleHighlight": { "type": "string", "default": "EXPERTISE" },
    "subtitle": {
      "type": "string",
      "default": "From concept to execution, we deliver comprehensive event production solutions"
    },
    "linkLabel": { "type": "string", "default": "Learn More" },
    "headline": { "type": "string", "default": "Comprehensive Technology Solutions" },
    "items": {
      "type": "array",
      "default": [
        { "title": "Event Production", "desc": "Full-scale event execution from concept to reality", "icon": "✦", "iconId": 0, "iconUrl": "", "color": "#d946ef" },
        { "title": "Stage Design", "desc": "Custom stages that captivate and inspire", "icon": "▣", "iconId": 0, "iconUrl": "", "color": "#06b6d4" },
        { "title": "Lighting Design", "desc": "Innovative lighting that sets the mood", "icon": "◉", "iconId": 0, "iconUrl": "", "color": "#f59e0b" },
        { "title": "Audio & Visual", "desc": "Crystal clear sound and stunning visuals", "icon": "◌", "iconId": 0, "iconUrl": "", "color": "#f43f5e" },
        { "title": "Festival Production", "desc": "Large-scale outdoor and indoor festivals", "icon": "◎", "iconId": 0, "iconUrl": "", "color": "#10b981" },
        { "title": "Corporate Events", "desc": "Professional events that impress", "icon": "↗", "iconId": 0, "iconUrl": "", "color": "#8b5cf6" }
      ]
    },
    "headlineEn": { "type": "string" },
    "headlinePl": { "type": "string" }
  }
}
